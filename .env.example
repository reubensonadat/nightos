# ─────────────────────────────────────────────────────────────
# NightOS — Frontend environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── SUPABASE — Backend Database & Auth ──
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ── PAYSTACK — Payment Gateway (get keys at https://dashboard.paystack.com) ──
# Public TEST key (sk-safe, starts with pk_test_) — used in development
VITE_PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# Public LIVE key (starts with pk_live_) — used when Vite builds for production.
# Leave blank until go-live; the PaystackButton refuses to charge without it.
VITE_PAYSTACK_LIVE_KEY=

# WARNING: NEVER put your Paystack SECRET key (sk_test_... / sk_live_...) here.
# VITE_* variables get bundled into the browser and shipped to every client.
# The secret key lives ONLY in Supabase Dashboard → Edge Functions → Secrets.
# See PAYMENTS_SETUP.md for the full provisioning runbook.
